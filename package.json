{
  "name": "press-reader",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "外刊精读 · 单文件 HTML 英语精读工具：分段翻译 / 生词标注 / 听力精听 / 闪卡复习",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node serve.mjs --open",
    "serve": "node serve.mjs",
    "test": "node build.mjs && node test/unit.mjs && node test/smoke.mjs",
    "test:unit": "node test/unit.mjs",
    "test:feeds": "node test/feeds.mjs",
    "apk": "node android/build-android.mjs",
    "data:atlantic": "node tools/build-atlantic.mjs data/epub src/atlantic.js",
    "apk:install": "node android/build-android.mjs --install",
    "test:android": "node android/test-android.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
